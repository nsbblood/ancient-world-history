<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    Info.plist Configuration Example for Ancient World Stories

    Copy the relevant sections below into your actual Info.plist file
    which should be automatically created by Xcode.
    -->

    <!-- SUPABASE CONFIGURATION (Optional) -->
    <!-- Add these keys if you're using Supabase for cloud data -->
    <key>SUPABASE_URL</key>
    <string>https://your-project-id.supabase.co</string>

    <key>SUPABASE_ANON_KEY</key>
    <string>your-anon-key-here-from-supabase-dashboard</string>


    <!-- CUSTOM FONTS (When Added) -->
    <!-- Uncomment and add your custom font files -->
    <!--
    <key>UIAppFonts</key>
    <array>
        <string>PlayfairDisplay-Regular.ttf</string>
        <string>PlayfairDisplay-Bold.ttf</string>
        <string>PlayfairDisplay-Italic.ttf</string>
        <string>Cinzel-Regular.ttf</string>
        <string>Cinzel-Bold.ttf</string>
    </array>
    -->


    <!-- APP TRANSPORT SECURITY -->
    <!-- Allow HTTP connections to Supabase (if needed) -->
    <!-- Only use in development, not for production -->
    <!--
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>supabase.co</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <false/>
                <key>NSIncludesSubdomains</key>
                <true/>
            </dict>
        </dict>
    </dict>
    -->


    <!-- LAUNCH SCREEN -->
    <!-- Xcode 15+ uses Info.plist for launch screen configuration -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>appBackground</string>
        <key>UIImageName</key>
        <string>LaunchIcon</string>
    </dict>


    <!-- SUPPORTED INTERFACE ORIENTATIONS -->
    <!-- iPhone -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <!-- Uncomment for landscape support -->
        <!--
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
        -->
    </array>

    <!-- iPad (if supporting) -->
    <!--
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    -->


    <!-- PRIVACY USAGE DESCRIPTIONS -->
    <!-- Required if using certain iOS features -->

    <!-- Speech Recognition (if using online speech) -->
    <!--
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Ancient World Stories uses speech recognition to provide audio narration of stories.</string>
    -->

    <!-- Microphone (if adding voice recording features) -->
    <!--
    <key>NSMicrophoneUsageDescription</key>
    <string>Ancient World Stories needs microphone access for voice recording features.</string>
    -->

    <!-- Photo Library (if adding image sharing features) -->
    <!--
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Ancient World Stories would like to save story illustrations to your photo library.</string>
    -->


    <!-- BACKGROUND MODES (if adding audio background playback) -->
    <!--
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    -->


    <!-- APP CATEGORY -->
    <!-- Helps with App Store categorization -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.books</string>


    <!-- MINIMUM iOS VERSION -->
    <!-- Already set in build settings, but can be reinforced here -->
    <key>MinimumOSVersion</key>
    <string>17.0</string>


    <!-- STATUS BAR STYLE -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>

    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>


    <!-- SCENE CONFIGURATION (Auto-generated by Xcode) -->
    <!-- Leave this section as-is from Xcode's template -->

</dict>
</plist>
