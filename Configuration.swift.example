import Foundation

enum Configuration {
    // MARK: - Supabase Configuration

    // Get these values from: https://supabase.com/dashboard
    // Your Project → Settings → API

    static let supabaseURL = "https://your-project-id.supabase.co"
    static let supabaseAnonKey = "your-anon-public-key-here"

    // MARK: - Helper Methods
    static var isSupabaseConfigured: Bool {
        return !supabaseURL.isEmpty
            && !supabaseAnonKey.isEmpty
            && !supabaseURL.contains("your-project-id")
            && !supabaseAnonKey.contains("your-anon-public-key")
    }
}
